<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcgis_log_list" model="ir.ui.view">
        <field name="name">arcgis.sync.log.list</field>
        <field name="model">arcgis.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="connector_id"/>
                <field name="operation"/>
                <field name="state"/>
                <field name="tasks_read"/>
                <field name="features_ready"/>
                <field name="added"/>
                <field name="updated"/>
                <field name="skipped"/>
                <field name="failed"/>
                <field name="message"/>
            </list>
        </field>
    </record>
    <record id="view_arcgis_log_form" model="ir.ui.view">
        <field name="name">arcgis.sync.log.form</field>
        <field name="model">arcgis.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="connector_id"/>
                        <field name="create_date"/>
                        <field name="operation"/>
                        <field name="state"/>
                        <field name="tasks_read"/>
                        <field name="features_ready"/>
                        <field name="added"/>
                        <field name="updated"/>
                        <field name="skipped"/>
                        <field name="failed"/>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_arcgis_logs" model="ir.actions.act_window">
        <field name="name">Synchronization Logs</field>
        <field name="res_model">arcgis.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_arcgis_logs" name="Synchronization Logs" parent="menu_arcgis_root"
              action="action_arcgis_logs" sequence="20" groups="base.group_system"/>
</odoo>
