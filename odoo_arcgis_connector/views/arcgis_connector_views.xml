<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_arcgis_connector_list" model="ir.ui.view">
        <field name="name">arcgis.connector.list</field>
        <field name="model">arcgis.connector</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="layer_url"/>
                <field name="active"/>
                <field name="auto_sync_enabled"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>
    <record id="view_arcgis_connector_form" model="ir.ui.view">
        <field name="name">arcgis.connector.form</field>
        <field name="model">arcgis.connector</field>
        <field name="arch" type="xml">
            <form string="ArcGIS Connector">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="btn-secondary"/>
                    <button name="action_preview_sync" type="object" string="Dry Run" class="btn-secondary"/>
                    <button name="action_sync_now" type="object" string="Synchronize Now" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="ArcGIS Connection">
                            <field name="layer_url" placeholder="https://services.arcgis.com/.../FeatureServer/0"/>
                            <field name="arcgis_token" password="True"/>
                            <field name="active"/>
                        </group>
                        <group string="Automation">
                            <field name="auto_sync_enabled"/>
                            <field name="last_sync_date" readonly="1"/>
                            <field name="last_sync_message" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Synchronization Logs">
                            <field name="log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="operation"/>
                                    <field name="state"/>
                                    <field name="tasks_read"/>
                                    <field name="added"/>
                                    <field name="updated"/>
                                    <field name="skipped"/>
                                    <field name="failed"/>
                                </list>
                            </field>
                        </page>
                        <page string="Required ArcGIS Fields">
                            <p>The target feature layer must contain these fields:</p>
                            <ul>
                                <li>ODOO_TASK_ID — integer/long</li>
                                <li>TASK_NAME — text</li>
                                <li>PROJECT — text</li>
                                <li>STAGE — text</li>
                                <li>CUSTOMER — text</li>
                                <li>DEADLINE — date</li>
                            </ul>
                            <p>The layer must support query and applyEdits and accept WKID 4326 point coordinates.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_arcgis_connector" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">arcgis.connector</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_arcgis_root" name="ArcGIS Integration" sequence="85" groups="base.group_system"/>
    <menuitem id="menu_arcgis_connections" name="Connections" parent="menu_arcgis_root"
              action="action_arcgis_connector" sequence="10" groups="base.group_system"/>
</odoo>
